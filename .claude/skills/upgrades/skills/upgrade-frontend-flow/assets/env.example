# .env for the automated-tests repository — written by /upgrade-frontend-flow Phase 0.
# NEVER commit this file. Values come from the executor at the start of the run.
#
# generate-test-files.sh parses this file to build {project}.config.ts:
#   - a key containing BASE_URL or ending in _URL  -> config.environments.<camelCase>
#   - any other key                                -> config.users.<role>.<lastSegment>
#     (a trailing _EMAIL / _PASSWORD is stripped from the role name)

# --- Environments -----------------------------------------------------------
# BASE_URL is the ONLY variable that feeds use.baseURL. Point it at the portal
# the current phase targets: ORIGINAL_URL in Phase 1, UPGRADE_URL from Phase 2.
# Override per command instead of editing this file:
#   BASE_URL=$UPGRADE_URL npx playwright test <spec>
BASE_URL=https://original.example.com

ORIGINAL_URL=https://original.example.com
UPGRADE_URL=http://localhost:8080

# --- Users ------------------------------------------------------------------
# One pair per role the test map needs. ADMIN_EMAIL + ADMIN_PASSWORD become
# config.users.admin.email and config.users.admin.password.
ADMIN_EMAIL=test@liferay.com
ADMIN_PASSWORD=
