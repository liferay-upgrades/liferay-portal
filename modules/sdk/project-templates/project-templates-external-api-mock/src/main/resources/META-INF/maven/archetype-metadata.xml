<?xml version="1.0"?>

<archetype-descriptor name="liferay-module-external-api-mock">
	<fileSets>
		<fileSet filtered="true" packaged="true">
			<directory>src/main/java</directory>
			<includes>
				<include>**/*.java</include>
			</includes>
		</fileSet>
		<fileSet packaged="true">
			<directory>src/main/resources</directory>
			<includes>
				<include>packageinfo</include>
			</includes>
		</fileSet>
		<fileSet>
			<directory>src/main/resources</directory>
			<includes>
				<include>mock-responses/*.json</include>
			</includes>
		</fileSet>
		<fileSet filtered="true">
			<directory></directory>
			<includes>
				<include>.gitignore</include>
				<include>README.md</include>
				<include>bnd.bnd</include>
				<include>build.gradle</include>
			</includes>
		</fileSet>
	</fileSets>
	<requiredProperties>
		<requiredProperty key="author">
		</requiredProperty>
		<requiredProperty key="buildType">
			<defaultValue>maven</defaultValue>
		</requiredProperty>
		<requiredProperty key="className">
		</requiredProperty>
		<requiredProperty key="jakartaCompatible">
		</requiredProperty>
		<requiredProperty key="liferayProduct">
			<defaultValue>portal</defaultValue>
			<validationRegex>(dxp)|(portal)</validationRegex>
		</requiredProperty>
		<requiredProperty key="liferayVersion">
			<validationRegex>^([0-7]\.\d+\.\d+.*|^2\d{3}\.q[1234]\.\d+)$</validationRegex>
		</requiredProperty>
	</requiredProperties>
</archetype-descriptor>