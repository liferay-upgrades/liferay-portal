package com.liferay.source.formatter.dependencies.upgrade;

import org.osgi.service.component.annotations.Reference;

/**
 * @author Lucas Ferruccio
 */
public class LPD_102569 {

	public void method(
		long groupId, boolean privateLayout, long layoutId,
		String typeSettings) {

		LayoutLocalServiceUtil.updateLayout(
			123, privateLayout, layoutId, typeSettings);
		LayoutLocalServiceUtil.updateTypeSettings(groupId, privateLayout, layoutId, typeSettings);
		LayoutServiceUtil.updateTypeSettings(groupId, privateLayout, layoutId, typeSettings);
		_layoutLocalService.updateTypeSettings(groupId, privateLayout, layoutId, typeSettings);
		_layoutService.updateTypeSettings(groupId, privateLayout, layoutId, typeSettings);
	}

	@Reference
	private LayoutLocalService _layoutLocalService;

	@Reference
	private LayoutService _layoutService;

}