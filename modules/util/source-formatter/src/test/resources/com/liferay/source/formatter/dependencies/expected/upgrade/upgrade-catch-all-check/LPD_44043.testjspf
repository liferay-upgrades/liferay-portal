<%
Liferay.Util.openToast({
	closeable: true,
	delay: {
		hide: 5000,
		show: 0,
	},
	duration: 500,
	message: message,
	title: Liferay.Language.get('warning'),
	type: 'warning',
});

Liferay.Util.openToast({
	closeable: true,
	delay: {
		hide: 5000,
		show: 0,
	},
	duration: 500,
	message: message,
	title: Liferay.Language.get('warning'),
	type: 'warning',
	render: true,
});
%>