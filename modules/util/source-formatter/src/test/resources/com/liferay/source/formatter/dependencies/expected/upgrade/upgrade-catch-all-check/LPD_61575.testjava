package com.liferay.source.formatter.dependencies.upgrade;

import java.io.File;

import java.nio.file.Files;

/**
 * @author Jessyca Ferreira
 */
public class LPD_61575 {

	public void method(MailMessage mailMessage, File file, String nameFile) {
		try {
			mailMessage.addFileAttachment(nameFile, Files.newInputStream(file.toPath()));
		} catch (IOException e) {
			throw new RuntimeException(e);
		}
		mailMessage.addFileAttachment(null, nameFile);
	}

}