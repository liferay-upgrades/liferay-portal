package com.liferay.source.formatter.dependencies.upgrade;

import org.osgi.service.component.annotations.Reference;

/**
 * @author Paulo Pereira
 */
public class LPD_101848 {

	public void method(
			String externalReferenceCode, long userId, long groupId,
			String name, ServiceContext serviceContext)
		throws PortalException {

		AssetTagLocalServiceUtil.addTag(
			"test123", groupId, name, serviceContext);

		AssetTagLocalServiceUtil.addTag(userId, groupId, name, serviceContext);

		AssetTagLocalServiceUtil.addTag(
			externalReferenceCode, userId, groupId, name, serviceContext);

		_assetTagLocalService.addTag(userId, groupId, name, serviceContext);

		_assetTagLocalService.addTag(
			externalReferenceCode, userId, groupId, name, serviceContext);
	}

	@Reference
	private AssetTagLocalService _assetTagLocalService;

}