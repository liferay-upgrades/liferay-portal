package com.liferay.source.formatter.dependencies.upgrade;

/**
 * @author Lucas Ferruccio
 */
public class LPD_48413 implements UpgradeStepRegistrator {

	@Override
	public void register(Registry registry) {
		try {
			BaseUpgradeServiceModuleRelease upgradeServiceModuleRelease =
				new BaseUpgradeServiceModuleRelease() {

					@Override
					protected String getNamespace() {
						return "Customer";
					}

					@Override
					protected String getNewBundleSymbolicName() {
						return "com.customer.commerce.invoice.management.service";
					}

					@Override
					protected String getOldBundleSymbolicName() {
						return "customer-commerce-invoice-service";
					}

				};
			upgradeServiceModuleRelease.upgrade();
		}
		catch (UpgradeException upgradeException) {
			throw new RuntimeException(upgradeException);
		}

		registry.registerInitialization();

		registry.register("0.0.1", "1.0.0", new DummyUpgradeStep());
		registry.register("1.0.0", "1.0.1", new DummyUpgradeStep());
		registry.register("1.0.1", "1.0.2", new UpgradeSchema());
	}

}