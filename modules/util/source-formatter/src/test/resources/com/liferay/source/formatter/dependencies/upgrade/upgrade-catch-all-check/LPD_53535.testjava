package com.liferay.source.formatter.dependencies.upgrade;

/**
 * @author Wilson Ferreira
 */
public class LPD_53535 {

	public void method(CommerceOrderItem orderItem) {
		CommerceInventoryBookedQuantityLocalServiceUtil.
			deleteCommerceInventoryBookedQuantity(
				orderItem.getBookedQuantityId());
		orderItem.setBookedQuantityId();
		orderItem.fetchByBookedQuantityId();
		orderItem.findByBookedQuantityId();
		orderItem.fetchBookedQuantityId();
		orderItem.removeByBookedQuantityId();
		orderItem.countByBookedQuantityId();
		orderItem.fetchCommerceOrderItemByBookedQuantityId();
	}

}