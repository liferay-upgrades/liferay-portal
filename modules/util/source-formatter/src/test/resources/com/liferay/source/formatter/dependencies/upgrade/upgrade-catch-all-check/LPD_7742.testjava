package com.liferay.source.formatter.dependencies.upgrade;

/**
 * @author Lucas Ferruccio
 */
public class LPD_7742 implements UpgradeStepRegistrator {

	public void method(Registry registry) {
		try {
			BaseUpgradeServiceModuleRelease upgradeServiceModuleRelease =
				new BaseUpgradeServiceModuleRelease() {

					@Override
					protected String getNamespace() {
						return "OSB";
					}

					@Override
					protected String getNewBundleSymbolicName() {
						return "com.liferay.osb.www.marketing.ev" +
							"ents.service";
					}

					@Override
					protected String getOldBundleSymbolicName() {
						return "osb-www-marketing-events-portlet";
					}

				};

			upgradeServiceModuleRelease.upgrade();
		}
		catch (UpgradeException ue) {
			throw new RuntimeException(ue);
		}
	}

}