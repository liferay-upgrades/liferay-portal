package com.liferay.source.formatter.dependencies.upgrade;

/**
 * @author Mateus Xavier
 */
public class LPD_83995 {

	public void method() {
		this.setActive(
			new Boolean(
				notification.getActive()
			).toString());
		this.setCookieEnabled(
			new Boolean(
				notification.getCookieEnabled()
			).toString());
		this.setVisibility(
			new Boolean(
				notification.getVisibility()
			).toString());
	}

}